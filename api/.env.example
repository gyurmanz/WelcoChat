# SQL (MySQL)
SQL_HOST=
SQL_PORT=3306
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MIN=60

# FRONTEND (portal lives under /portal on the same origin as this API)
FRONTEND_BASE_URL=http://localhost:5173/portal

# Public base URL of this API — used to build the widget embed snippet,
# the WhatsApp webhook URL, and uploaded-logo URLs.
API_BASE_URL=https://welcochat.com/api

# SMTP / email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM="WelcoChat Support <notification@example.com>"
SUBJECT_PASSWORD_RESET=WelcoChat Password Reset Request
SUBJECT_EMAIL_VERIFICATION=WelcoChat Email Verification

# WelcoChat engine (Anthropic API key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_WORKSPACE_ID=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Sign-In (OAuth authorization-code flow). All three required, or
# Google login is silently disabled. Each redirect URI must also be
# registered on the Google OAuth client under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_REDIRECT_URIS=http://localhost:5173/portal/auth/google/callback
